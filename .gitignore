node_modules/
out/
dist/
# electron-builder 的版本化输出目录（dist160/ dist161/ dist162/ …），
# 每个都含一份完整安装包 + win-unpacked/，禁止入库。
desktop-app/dist*/
pkgout*/
cloud-server/data/
cloud-server/*.log
cloud-server/*.err
.env
.env.*
*.exe
*.bin
*.gguf

# Local LLM runtime (llama.cpp, ~86MB, must never be committed).
# Scoped to the repo root only, so desktop-app/resources stays tracked.
/resources/

# llama runtime DLLs copied into desktop-app for packaging (kept out of git).
desktop-app/resources/llama/*.dll
desktop-app/resources/llama/LICENSE-LLVM-OpenMP

# 内置云端凭据（发布时由 desktop-app/scripts/inject-gateway.js 生成，不进仓库）
desktop-app/resources/gateway.json

desktop-app/release-build/
desktop-app/dist168/
desktop-app/win-unpacked/
desktop-app/dist168_*/
desktop-app/node_modules/
desktop-app/pty_stdout*.txt

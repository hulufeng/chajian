{
  "name": "BubaiCode",
  "version": "1.2.33",
  "description": "BubaiCode —— 用 AI 打通「从引脚到固件」的嵌入式开发全流程。",
  "main": "main/index.js",
  "author": {
    "name": "BubaiCode Team",
    "email": "dev@bubaicode.local"
  },
  "homepage": "https://github.com/hulufeng/BubaiCode",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/verify-all.cjs",
    "test:workflow": "node scripts/wf_integration_test.js",
    "build": "electron-builder",
    "build:win": "electron-rebuild -f -w serialport,node-pty && electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "prebuild": "node scripts/inject-gateway.js",
    "prebuild:win": "node scripts/inject-gateway.js",
    "prebuild:mac": "node scripts/inject-gateway.js",
    "prebuild:linux": "node scripts/inject-gateway.js"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "jsdom": "^31.0.1"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@tabler/icons": "^3.46.0",
    "@tabler/icons-webfont": "^3.36.0",
    "electron-updater": "^6.1.7",
    "iconv-lite": "^0.6.3",
    "monaco-editor": "^0.45.0",
    "mqtt": "^5.16.1",
    "node-pty": "^1.1.0",
    "serialport": "^12.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "build": {
    "appId": "com.BubaiCode.app",
    "productName": "BubaiCode",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist179"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://bluebubai.work/updates"
      }
    ],
    "files": [
      "main/**/*",
      "renderer/**/*",
      "packages/**/*",
      "resources/**/*",
      "!resources/llama/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/llama",
        "to": "llama",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/lora",
        "to": "lora",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/@serialport/**",
      "**/node_modules/serialport/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BubaiCode"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Development"
    },
    "artifactName": "BubaiCode-Setup-${version}.${ext}"
  }
}
